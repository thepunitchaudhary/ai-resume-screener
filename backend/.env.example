# Groq API key - get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Postgres connection string
# Local example:   postgresql://postgres:password@localhost:5432/resume_screener
# Free hosted db:  create one at https://neon.tech and paste the connection string here
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_screener

# Which Groq model to use for screening
GROQ_MODEL=llama-3.3-70b-versatile
